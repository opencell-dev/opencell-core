# A daily differential backup of one stanza (postgres-ha spec §10.2), on
# oc-ldn-1. With no full backup yet, pgBackRest takes a full one instead.
[Unit]
Description=pgBackRest differential backup of %i
After=network-online.target wg-quick@wg0.service

[Service]
Type=oneshot
User=postgres
ExecStart=/usr/bin/pgbackrest --stanza=%i --type=diff backup
