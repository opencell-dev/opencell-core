#!/usr/bin/python3
"""oc-clip-gen: the playback service's clip (core test services spec §5.2).

    oc-clip-gen WORD OUT.wav        WORD: one, two, three or four (the core)

Speaks "This is OpenCell core WORD. Playback test. Your call is
connected." and then Harvard sentences list 1, sentences 1-5 (IEEE 1969),
in one Piper run (the piper-tts program: OC_PIPER, default `piper` on the
PATH) with the en_US-lessac-medium voice (OC_PIPER_MODEL, default
~/.cache/opencell-piper/en_US-lessac-medium.onnx) at 1.2x length;
resamples to 8 kHz (scipy); adds 1 s of silence at the end; pads to whole
120 ms blocks (960 samples). Nothing else: no band filter and no level
change, except a scale down to a -1 dBFS peak where the resampled speech
would clip (filtering and a hot level cost Codec2 1200 words: 23% word
errors against 8% unprocessed, 2026-10-12). OUT.wav is an 8 kHz mono 16-bit
WAV, what oc-core's playback_clip takes (playback clip spec 2026-10-12):
oc-core encodes it at start. Piper's voice samples noise, so each run
differs a little: the committed clip is the reference, not
this program's output. Run on the laptop, never on a core.
"""
import os
import subprocess
import sys
import tempfile
import wave
from math import gcd
from pathlib import Path

import numpy as np
from scipy.signal import resample_poly

HARVARD_1 = [
    "The birch canoe slid on the smooth planks.",
    "Glue the sheet to the dark blue background.",
    "It's easy to tell the depth of a well.",
    "These days a chicken leg is a rare dish.",
    "Rice is often served in round bowls.",
]
WORDS = ("one", "two", "three", "four")
RATE, BLOCK = 8000, 960
PIPER = os.environ.get("OC_PIPER", "piper")
MODEL = os.environ.get("OC_PIPER_MODEL", str(Path.home() / ".cache/opencell-piper/en_US-lessac-medium.onnx"))


def say(text: str) -> np.ndarray:
    """text spoken by Piper, at 8 kHz, floats."""
    with tempfile.TemporaryDirectory() as d:
        out = Path(d) / "say.wav"
        subprocess.run([PIPER, "-m", MODEL, "-f", str(out), "--length-scale", "1.2"],
                       input=text.encode(), check=True, capture_output=True)
        with wave.open(str(out)) as w:
            rate = w.getframerate()
            x = np.frombuffer(w.readframes(w.getnframes()), dtype="<i2").astype(np.float64) / 32768.0
    g = gcd(rate, RATE)
    return resample_poly(x, RATE // g, rate // g)


def main() -> None:
    if len(sys.argv) != 3 or sys.argv[1] not in WORDS:
        raise SystemExit("usage: oc-clip-gen one|two|three|four OUT.wav")
    text = f"This is OpenCell core {sys.argv[1]}. Playback test. Your call is connected. " + " ".join(HARVARD_1)
    x = np.concatenate([say(text), np.zeros(RATE)])
    x *= min(1.0, (10 ** (-1 / 20)) / max(1e-9, float(np.max(np.abs(x)))))
    x = np.concatenate([x, np.zeros((-len(x)) % BLOCK)])
    pcm = np.clip(np.round(x * 32767), -32768, 32767).astype("<i2")
    with wave.open(sys.argv[2], "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(RATE)
        w.writeframes(pcm.tobytes())
    print(f"{sys.argv[2]}: {len(pcm) / RATE:.2f} s, {len(pcm) // BLOCK} blocks of 120 ms")


if __name__ == "__main__":
    main()
