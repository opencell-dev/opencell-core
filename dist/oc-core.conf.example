# /etc/opencell/oc-core.conf: the network core (network-core spec §4.2).
# key = value; '#' starts a comment. An unknown key stops oc-core.
core_id = 1
key_id = 1
echo = +883160655500100
# The playback service (core test services spec §5): a second service
# number in this core's block, and its clip: an 8 kHz mono 16-bit WAV,
# encoded at start (playback clip spec 2026-10-12; dist/clips/,
# tools/clip/oc-clip-gen). Both or neither.
#playback = +883160655500101
#playback_clip = /etc/opencell/playback.wav
# Stream channels (streaming channel spec 2026-11-01): NUMBER URL OFFLINE_CLIP,
# up to 4 lines. A call to NUMBER (a full number in this core's block, no
# subscriber's) hears the live stream at URL, fetched by a confined ffmpeg
# only while a call is on it (and 5 s after); 1 h at most. If the stream
# doesn't start in 10 s, or fails, the caller hears OFFLINE_CLIP (a WAV as
# playback_clip's, 30 s at most; oc-clip-gen say TEXT OUT.wav) and is hung
# up. stream_ffmpeg: the ffmpeg to run (apt install ffmpeg).
#stream = +883186540901021 https://s4.radio.co/sbd220eafd/listen /etc/opencell/stream-hamshack-offline.wav
#stream_ffmpeg = /usr/bin/ffmpeg
# PREFIX INDEX [HOME_CORE]: a numbering block (one line each). Without
# HOME_CORE it is this core's; with another core's id, calls to its numbers
# go to that core over OCSS, which needs a peer line for it.
block = 8831606 1
#block = 8831503 2 2
db = /var/lib/opencell/core/core.db
cell_socket = /run/opencell/core.sock
cell_group = oc-cell
admin_socket = /run/opencell/admin.sock
admin_group = oc-admin
# The core's name in core.status (default oc-core-<core_id>)
#name = oc-core-1
# The admin API (portal spec §7): TLS 1.3 on a private address only. The
# portal's client certificate must chain to api_ca, carry the portal role
# and be pinned here (oc-ca fpr portal.crt; up to 4 lines, for a rotation).
# The config is read at start: a pin added or removed (a rotation, a stolen
# certificate) takes effect at `systemctl restart oc-core`, which also
# drops the cells' links for a moment (they reconnect).
# A value with no '/' is a systemd credential (LoadCredential=NAME:PATH).
# api_listen may name an address that is not up yet (at boot): the core
# starts, and the API answers once the address is there.
#api_listen = 10.0.0.60:7444
#api_cert = /etc/opencell/tls/core.crt
#api_key = api.key
#api_ca = /etc/opencell/tls/ca.crt
#api_portal_fpr = <64 hex digits>
# Cells over TLS (single-board cells, cells on other hosts): all four or none.
# cell_listen: the core's public address. A wildcard (0.0.0.0:7443) clashes
# with an ocss_listen on the same port (EADDRINUSE).
#cell_listen = 203.0.113.10:7443
#cell_cert = cell-server.crt
#cell_key = cell-server.key
#cell_ca = /etc/opencell/ca.crt
# Per-operation rate limits (OP PER_HOUR BURST); the defaults are in oc_api.c.
# "unknown" is op 0 and any operation the core does not have.
#api_rate = sub.disable 30 10
# OCSS, the links to other cores (core test services spec §6-7): one line
# per core, CORE_ID ADDRESS|- SHA256. The lower core_id dials: give the
# address of a core with a higher id, "-" for one with a lower id (it dials
# here, so ocss_listen is needed). SHA256: `oc-ca fpr` of that core's OCSS
# certificate (role core). The ocss_* files as the api_* ones; a pin change
# takes effect at a restart.
#peer = 2 10.99.0.2:7443 <64 hex digits>
#ocss_listen = 10.99.0.2:7443
#ocss_cert = /etc/opencell/tls/ocss.crt
#ocss_key = ocss.key
#ocss_ca = /etc/opencell/tls/ca.crt
