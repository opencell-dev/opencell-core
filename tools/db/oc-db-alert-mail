#!/usr/bin/env python3
"""oc-db-alert-mail: the OnFailure mailer shared by oc-db-check, oc-zfs-snap and
oc-etcd-defrag (review I1, M2). Their units nothing else watches -- a killed
oc-db-check never reaches its own send_mail, and oc-zfs-snap/oc-etcd-defrag
have no monitoring at all -- so systemd's own OnFailure= calls this instead,
from the same alert-smtp.env as oc-db-check's other alerts.

  oc-db-alert-mail UNIT [--env FILE]   UNIT is the failing unit's name (%I)

Standard library only (Debian 13's python3).
"""
import argparse
import smtplib
import socket
import ssl
import sys
from email.message import EmailMessage


def read_env(path):
    env = {}
    with open(path) as f:
        for line in f:
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                env[k] = v
    return env


def send(env_path, unit, host):
    env = read_env(env_path)
    msg = EmailMessage()
    msg["From"], msg["To"] = env["SMTP_USER"], env["ALERT_TO"]
    msg["Subject"] = f"[OpenCell db] {unit} failed on {host}"
    msg.set_content(f"systemd reports {unit} failed on {host}.\n\n"
                     f"journalctl -u {unit} for the reason; runbooks: "
                     "docs/ops/postgres-runbooks.md in the docs repository.\n")
    with smtplib.SMTP(env["SMTP_HOST"], int(env.get("SMTP_PORT", "587")), timeout=20) as s:
        s.starttls(context=ssl.create_default_context())
        s.login(env["SMTP_USER"], env["SMTP_TOKEN"])
        s.send_message(msg)


def main(argv):
    ap = argparse.ArgumentParser(description="mail that UNIT failed, for OnFailure=")
    ap.add_argument("unit")
    ap.add_argument("--env", default="/etc/opencell/alert-smtp.env")
    a = ap.parse_args(argv)
    send(a.env, a.unit, socket.gethostname())
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
