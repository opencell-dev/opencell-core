# etcd's monthly defragmentation (postgres-ha spec §6), one member at a
# time, from oc-ldn-1.
[Unit]
Description=Defragment the OpenCell etcd members
After=network-online.target wg-quick@wg0.service

[Service]
Type=oneshot
ExecStart=/usr/bin/etcdctl --endpoints=https://10.99.0.4:2379,https://10.99.0.2:2379,https://10.99.0.3:2379 --cacert=/etc/opencell/db-tls/ca.crt --cert=/etc/opencell/db-tls/db.crt --key=/etc/opencell/db-tls/db.key defrag
