# A weekly full backup of one stanza (postgres-ha spec §10.2), on oc-ldn-1.
# pgBackRest expires what repo1-retention-full no longer needs afterwards.
[Unit]
Description=pgBackRest full backup of %i
After=network-online.target wg-quick@wg0.service

[Service]
Type=oneshot
User=postgres
ExecStart=/usr/bin/pgbackrest --stanza=%i --type=full backup
